# Modeem AI Platform — example environment variables (no real secrets)

# API
ENVIRONMENT=development
DATABASE_URL=postgresql://modeem:modeem@localhost:5432/modeem
REDIS_URL=redis://localhost:6379/0

# Authentication (Phase 2A) — set a strong random value; never commit real secrets
AUTH_SECRET=<placeholder-change-me>

# Connections (Phase 2B) — AES-256-GCM key: URL-safe Base64 of 32 random bytes.
# Independent of AUTH_SECRET; never derive or reuse it. Generate with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CONNECTION_ENCRYPTION_KEY=<placeholder-change-me>

# Bootstrap admin (development only; never commit real values)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<placeholder-change-me>
BOOTSTRAP_TENANT_NAME=Example Tenant

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
